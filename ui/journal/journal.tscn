[node name="TranscriptEntry2" parent="TabContainer/Transcripts/Guard/VBoxContainer" instance=ExtResource("5_pa4op")]
layout_mode = 2
prompt = "So do you know anything about these missing stakes? Could make a pretty mean murder weapon against a powerful vampire like Dracula."
response = "No idea, detective. I know they were on the premises somewhere, and now they’re gone."

[node name="TranscriptEntry3" parent="TabContainer/Transcripts/Guard/VBoxContainer" instance=ExtResource("5_pa4op")]
